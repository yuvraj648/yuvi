<build>
  <plugins>
    <plugin>
      <groupId>org.apache.maven.plugins</groupId>
      <artifactId>maven-compiler-plugin</artifactId>
      <version>3.10.1</version> <!-- newer version -->
      <configuration>
        <source>17</source>   <!-- or 22 if you're using JDK 22 -->
        <target>17</target>
      </configuration>
    </plugin>
  </plugins>
</build>
